<!DOCTYPE html>
<html lang="cs">
<%- include('partials/head', {
    description: `Pronajměte si vůz, který vás doveze dál. Vyberte si z nabídky ${titulek} a vyrazte na cestu.`,
    pageTitle: `${titulek} — půjčovna, která vás dostane dál`
}) %>
<body>
    <header class="site-header">
        <a class="brand" href="/" aria-label="<%= titulek %> — úvodní stránka">
            <span class="brand-mark"><%= titulek.charAt(0).toUpperCase() %></span>
            <span><%= titulek %><span class="brand-period">.</span></span>
        </a>
        <nav class="main-nav" aria-label="Hlavní navigace">
            <a href="/about">O aplikaci</a>
            <% if (currentUser) { %>
                <a href="/users/profile">Můj profil</a>
            <% } else { %>
                <a href="/users/login">Přihlášení</a>
                <a href="/users/register">Registrace</a>
            <% } %>
        </nav>
        <a class="header-link" href="#vozy">Vybrat vůz <span aria-hidden="true">↗</span></a>
    </header>

    <main>
        <section class="hero">
            <div class="hero-shade"></div>
            <div class="hero-content">
                <p class="eyebrow"><span class="eyebrow-line"></span> Půjčovna aut bez starostí</p>
                <h1>Kam dál?<br><span>Je to na vás.</span></h1>
                <p class="hero-copy">Vůz pro každý plán. Připravený, když jste vy.</p>
            </div>
            <div class="hero-caption"><span>01 / 03</span><span>Nové cesty začínají tady</span></div>
            <div class="hero-scroll">SJEĎTE DOLŮ <span aria-hidden="true">↓</span></div>
        </section>

        <section class="booking-panel" aria-label="Informace o pronájmu">
            <div class="booking-intro">
                <span class="booking-icon" aria-hidden="true">↗</span>
                <div><strong>Váš další vůz</strong><span>Čeká jen na vás</span></div>
            </div>
            <div class="booking-detail"><span class="field-label">MÍSTO VYZVEDNUTÍ</span><strong>Praha, Česká republika</strong></div>
            <div class="booking-detail"><span class="field-label">VYZVEDNUTÍ</span><strong>Kdykoliv se vám to hodí</strong></div>
        </section>

        <section class="fleet section-wrap" id="vozy">
            <div class="section-heading">
                <div>
                    <p class="eyebrow eyebrow-dark"><span class="eyebrow-line"></span> VYBERTE SI SVŮJ SMĚR</p>
                    <h2>Vůz pro každý <span>plán.</span></h2>
                </div>
            </div>
            <form class="item-form" action="/items/new" method="post">
                <input type="hidden" name="showOffers" value="<%= showOffers ? 'true' : '' %>">
                <div class="item-form-heading">
                    <p class="eyebrow eyebrow-dark"><span class="eyebrow-line"></span> NOVÝ VŮZ</p>
                    <h3>Přidejte vůz do nabídky</h3>
                    <p>Vyplňte údaje o autě. Cena je uvedena za den pronájmu.</p>
                </div>
                <div class="item-form-fields">
                    <label>Model vozu
                        <input name="name" type="text" required>
                    </label>
                    <label>Cena za den (Kč)
                        <input name="price" type="number" min="0" step="1" required>
                    </label>
                    <label class="item-form-wide">Popis
                        <textarea name="description" rows="3" required></textarea>
                    </label>
                    <label class="item-form-wide">Odkaz na obrázek
                        <input name="image" type="url" placeholder="https://…" required>
                    </label>
                </div>
                <button class="button button-dark" type="submit">Přidat vůz <span aria-hidden="true">↗</span></button>
            </form>
            <% if (!showOffers) { %>
                <a class="header-link offers-button" href="/items#vozy">Zobrazit nabídky <span aria-hidden="true">↗</span></a>
            <% } %>
            <% if (showOffers) { %>
                <% if (rentalError) { %><p class="form-error rental-error" role="alert"><%= rentalError %></p><% } %>
                <div class="car-grid">
                    <% if (items.length === 0) { %>
                        <p class="empty-offers">Nabídka je zatím prázdná. Přidejte první vůz pomocí formuláře výše.</p>
                    <% } %>
                    <% items.forEach((item, index) => { %>
                        <article class="car-card">
                            <div class="car-image">
                                <img src="<%= item.image %>" alt="<%= item.name %>" loading="lazy">
                                <span class="car-category"><%= String(index + 1).padStart(2, '0') %> — NABÍDKA</span>
                                <% if (item.imageCredit) { %>
                                    <a class="car-image-credit" href="<%= item.imageCredit.url %>" target="_blank" rel="noopener noreferrer"><%= item.imageCredit.text %></a>
                                <% } %>
                            </div>
                            <div class="car-info">
                                <div><p class="car-type">VŮZ K PRONÁJMU</p><h3><%= item.name %></h3></div>
                                <div class="car-price"><strong><%= Number(item.price).toLocaleString('cs-CZ') %> Kč</strong><span>/ den</span></div>
                            </div>
                            <p class="car-description"><%= item.description %></p>
                            <% if (item.rentedBy) { %>
                                <p class="rental-status"><%= currentUser && String(currentUser.id) === String(item.rentedBy) ? 'Pronajato vámi' : 'Již pronajato' %></p>
                            <% } else if (currentUser) { %>
                                <form class="rent-item-form" action="/items/rent/<%= item.id %>" method="post">
                                    <button class="button button-dark rent-item-button" type="submit">Pronajmout vůz <span aria-hidden="true">↗</span></button>
                                </form>
                            <% } else { %>
                                <a class="button button-dark rent-item-button rent-login-link" href="/users/login">Přihlaste se k pronájmu <span aria-hidden="true">↗</span></a>
                            <% } %>
                            <form class="delete-item-form" action="/items/delete/<%= item.id %>" method="post">
                                <input type="hidden" name="showOffers" value="true">
                                <button class="delete-item-button" type="submit">Odebrat vůz</button>
                            </form>
                        </article>
                    <% }) %>
                </div>
            <% } %>
        </section>

        <section class="benefits" id="vyhody">
            <div class="section-wrap benefits-inner">
                <div>
                    <p class="eyebrow"><span class="eyebrow-line"></span> JEDNODUŠE LEPŠÍ PRONÁJEM</p>
                    <h2>Svoboda na cestě.<br><span>Klid v hlavě.</span></h2>
                </div>
                <div class="benefit-list">
                    <article><span>01</span><div><h3>Žádná překvapení</h3><p>Jasné ceny a férové podmínky. Vždy víte, za co platíte.</p></div></article>
                    <article><span>02</span><div><h3>Vůz připravený vyrazit</h3><p>Každé auto před předáním pečlivě kontrolujeme a čistíme.</p></div></article>
                    <article><span>03</span><div><h3>Vaše cesta, vaše tempo</h3><p>Vyzvednutí i vrácení domluvíme tak, aby vám to vyhovovalo.</p></div></article>
                </div>
            </div>
        </section>
    </main>

    <%- include('partials/footer', {
        footerText: 'Dobré cesty začínají dobrým autem.',
        footerLink: '/about',
        footerLinkText: `Více o ${titulek}`
    }) %>
</body>
</html>
